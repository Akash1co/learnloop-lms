PORT=5000
NODE_ENV=development
FORCE_HTTPS=false
# Comma-separated allowed browser origins. Set the exact production frontend origin.
CORS_ORIGIN=*
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1h
DB_USER=root
DB_HOST=localhost
DB_NAME=learnloop_db
DB_PASSWORD=
DB_PORT=3306
DB_CONNECTION_LIMIT=10

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
EMAIL_FROM=LearnLoop <no-reply@example.com>

PAYMENT_PROVIDER=razorpay
PAYMENT_MODE=sandbox
PAYMENT_SECRET=replace-with-a-payment-signing-secret
PAYMENT_CURRENCY=INR
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
